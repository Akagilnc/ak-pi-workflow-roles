 // NEVER convert to top-level runtime imports - breaks browser/Vite builds
 const _os = loadNodeOs();
+// [ak-patch] codex fast switch. Source of truth: the CONTENT of
+// ~/.pi-codex-fast. Enabled only when the ENTIRE file matches
+// /^\s*fast_mode\s*=\s*on\s*$/; anything else -- missing file, empty file,
+// `fast_mode = off`, extra/conflicting content, unreadable file -- keeps
+// stock behavior. No TOML parser, no second gate. Read once per request
+// (tiny readFileSync, microseconds) and never cached, so flipping the file
+// takes effect on the next codex request without restarting anything.
+// Loader mirrors loadNodeZlib()/loadNodeOs(): browser (no Node runtime)
+// -> off; Bun builtins work. Reuses the existing _os; no second os loader.
+// Unreadable = off, never fake on.
+function loadNodeFs() {
+    if (typeof process === "undefined" || !(process.versions?.node || process.versions?.bun)) {
+        return null;
+    }
+    return process.getBuiltinModule?.("node:fs") ?? null;
+}
+function codexFastSwitchEnabled() {
+    const fs = loadNodeFs();
+    if (!fs || !_os) {
+        return false;
+    }
+    try {
+        return /^\s*fast_mode\s*=\s*on\s*$/.test(fs.readFileSync(`${_os.homedir()}/.pi-codex-fast`, "utf8"));
+    }
+    catch {
+        return false;
+    }
+}
