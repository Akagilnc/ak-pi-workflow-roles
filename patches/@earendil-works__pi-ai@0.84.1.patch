+// [ak-patch] Codex fast tier is controlled solely by the complete contents of
+// ~/.pi-codex-fast. Missing, unreadable, empty, off, or conflicting bytes keep
+// stock behavior. Read once per request so a switch change needs no restart.
+function loadNodeFs() {
+    if (typeof process === "undefined" || !(process.versions?.node || process.versions?.bun)) {
+        return null;
+    }
+    return process.getBuiltinModule?.("node:fs") ?? null;
+}
+function codexFastSwitchEnabled() {
+    const fs = loadNodeFs();
+    if (!fs || !_os) {
+        return false;
+    }
+    try {
+        return /^\s*fast_mode\s*=\s*on\s*$/.test(fs.readFileSync(`${_os.homedir()}/.pi-codex-fast`, "utf8"));
+    }
+    catch {
+        return false;
+    }
+}
