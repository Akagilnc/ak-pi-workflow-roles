{
  "name": "@ak/pi-workflow-roles",
  "version": "0.1.0",
  "description": "Soul-bound workflow roles for Pi",
  "type": "module",
  "keywords": ["pi-package"],
  "files": [
    "dist",
    "extensions",
    "scripts/generate-activation-trace-schema.ts",
    "scripts/generate-tool-execution-observation-schema.ts",
    "scripts/build-package.mjs",
    "src",
    "souls",
    "schemas",
    "packets",
    "README.md"
  ],
  "scripts": {
    "generate:activation-trace-schema": "tsx scripts/generate-activation-trace-schema.ts",
    "generate:tool-execution-observation-schema": "tsx scripts/generate-tool-execution-observation-schema.ts",
    "build": "npm run generate:activation-trace-schema && npm run generate:tool-execution-observation-schema && tsc -p tsconfig.build.json && node scripts/build-package.mjs",
    "prepack": "npm run build",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": ["./extensions/role-runtime.ts"]
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@types/node": "latest",
    "esbuild": "^0.28.1",
    "tsx": "latest",
    "typebox": "latest",
    "typescript": "latest"
  }
}
