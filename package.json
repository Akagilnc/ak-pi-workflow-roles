{
  "name": "@akagilnc/pi-workflow-roles",
  "version": "0.1.0",
  "description": "Soul-bound workflow roles for Pi",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "pi-package",
    "ai-agents",
    "agents",
    "agentic",
    "multi-agent",
    "agent-framework",
    "agent-orchestration",
    "ai-governance",
    "human-in-the-loop",
    "claude-code",
    "codex",
    "code-review",
    "llm",
    "ai",
    "typescript"
  ],
  "bin": {
    "ak-role": "dist/public-cli/main.js"
  },
  "files": [
    "dist",
    "!dist/package-resources/method-skill.js",
    "!dist/package-resources/method-skill-binding.js",
    "extensions",
    "scripts/build-package.mjs",
    "src",
    "souls",
    "schemas",
    "packets",
    "resources",
    "docs/adr/0057-schema-narrowing-cuts-the-required-set-not-the-declared-set.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CLAUDE.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node scripts/build-package.mjs",
    "prepack": "npm run build",
    "test": "vitest run --project unit-contract",
    "test:fast": "pnpm test",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate:book-topology": "node dist/migrate-book-topology.js"
  },
  "pi": {
    "extensions": []
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "typebox": "1.3.8"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@types/node": "latest",
    "esbuild": "^0.28.1",
    "execa": "^10.2.0",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Akagilnc/ak-pi-workflow-roles.git"
  }
}
