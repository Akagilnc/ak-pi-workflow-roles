{
  "name": "@ak/pi-workflow-roles",
  "version": "0.1.0",
  "description": "Soul-bound workflow roles for Pi",
  "type": "module",
  "keywords": ["pi-package"],
  "bin": {
    "ak-docket-record": "./bin/ak-docket-record.js",
    "ak-assisted-run": "./bin/ak-assisted-run.js"
  },
  "files": [
    "bin",
    "dist",
    "extensions",
    "scripts/build-rename-no-replace.mjs",
    "scripts/generate-activation-trace-schema.ts",
    "scripts/build-assisted.mjs",
    "scripts/rename_no_replace.c",
    "src",
    "souls",
    "schemas",
    "packets",
    "README.md"
  ],
  "os": ["darwin", "linux"],
  "cpu": ["x64", "arm64"],
  "scripts": {
    "build:native": "node scripts/build-rename-no-replace.mjs",
    "generate:activation-trace-schema": "tsx scripts/generate-activation-trace-schema.ts",
    "build:recorder": "npm run generate:activation-trace-schema && tsc -p tsconfig.recorder.json && node scripts/build-assisted.mjs && npm run build:native",
    "prepack": "npm run build:recorder",
    "install": "node scripts/build-rename-no-replace.mjs",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": ["./extensions/role-runtime.ts"]
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@types/node": "latest",
    "esbuild": "^0.28.1",
    "tsx": "latest",
    "typebox": "latest",
    "typescript": "latest"
  }
}
