{
  "anyOf": [
    {
      "type": "object",
      "required": [
        "role",
        "stageId",
        "status",
        "timestamp"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "stageId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "const": "started"
            },
            {
              "type": "string",
              "const": "completed"
            }
          ]
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "role",
        "stageId",
        "status",
        "timestamp",
        "cause"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "stageId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "status": {
          "type": "string",
          "const": "failed"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "cause": {
          "type": "object",
          "required": [
            "name",
            "message"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
