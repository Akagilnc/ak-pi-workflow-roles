{
  "type": "object",
  "required": [
    "role",
    "stageId",
    "status",
    "timestamp",
    "cause"
  ],
  "properties": {
    "role": {
      "type": "string",
      "minLength": 1
    },
    "stageId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "status": {
      "type": "string",
      "const": "failed"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "cause": {
      "type": "object",
      "required": [
        "identity",
        "name",
        "message"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string"
        },
        "evidenceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
