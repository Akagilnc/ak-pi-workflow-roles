{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ak.local/schemas/recorder-config-v2.schema.json",
  "title": "Recorder config v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "archive", "session", "execution", "declarations", "provenance"],
  "properties": {
    "version": { "const": 2 },
    "archive": { "$ref": "#/$defs/archive" },
    "session": { "$ref": "#/$defs/session" },
    "execution": { "$ref": "#/$defs/execution" },
    "declarations": { "$ref": "#/$defs/declarations" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "nonempty": { "type": "string", "minLength": 1 },
    "absolute": { "type": "string", "pattern": "^/" },
    "relative": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$" },
    "sha1": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "archive": { "type": "object", "additionalProperties": false, "required": ["repositoryRoot", "root", "docketId"], "properties": { "repositoryRoot": { "$ref": "#/$defs/absolute" }, "root": { "$ref": "#/$defs/relative" }, "docketId": { "$ref": "#/$defs/relative" } } },
    "session": { "type": "object", "additionalProperties": false, "required": ["directory", "id"], "properties": { "directory": { "type": "string", "pattern": "^\\.ak/work/(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//).+$" }, "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" } } },
    "environment": { "type": "object", "additionalProperties": false, "required": ["inherit", "overrides", "unset"], "properties": { "inherit": { "type": "boolean" }, "overrides": { "type": "object", "propertyNames": { "minLength": 1, "not": { "enum": ["PI_SESSION_DIR"] } }, "additionalProperties": { "type": "string" } }, "unset": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } },
    "execution": { "type": "object", "additionalProperties": false, "required": ["cwd", "environment", "stdin"], "properties": { "cwd": { "$ref": "#/$defs/absolute" }, "environment": { "$ref": "#/$defs/environment" }, "stdin": { "const": "inherit" } } },
    "gitReference": { "type": "object", "additionalProperties": false, "required": ["id", "repositoryRoot", "commit", "path", "blobOid", "sha256", "kind"], "properties": { "id": { "$ref": "#/$defs/id" }, "repositoryRoot": { "$ref": "#/$defs/absolute" }, "commit": { "$ref": "#/$defs/sha1" }, "path": { "$ref": "#/$defs/relative" }, "blobOid": { "$ref": "#/$defs/sha1" }, "sha256": { "$ref": "#/$defs/sha256" }, "kind": { "enum": ["authority", "task", "input", "exhibit"] } } },
    "externalInput": { "type": "object", "additionalProperties": false, "required": ["id", "sourcePath", "sha256", "kind"], "properties": { "id": { "$ref": "#/$defs/id" }, "sourcePath": { "$ref": "#/$defs/absolute" }, "sha256": { "$ref": "#/$defs/sha256" }, "kind": { "enum": ["authority", "task", "input"] } } },
    "exhibit": { "type": "object", "additionalProperties": false, "required": ["id", "sourcePath", "sha256"], "properties": { "id": { "$ref": "#/$defs/id" }, "sourcePath": { "$ref": "#/$defs/absolute" }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "declarations": { "type": "object", "additionalProperties": false, "required": ["gitReferences", "externalInputs", "exhibits"], "properties": { "gitReferences": { "type": "array", "items": { "$ref": "#/$defs/gitReference" } }, "externalInputs": { "type": "array", "items": { "$ref": "#/$defs/externalInput" } }, "exhibits": { "type": "array", "items": { "$ref": "#/$defs/exhibit" } } } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["package", "model", "target"], "properties": { "package": { "type": ["string", "null"] }, "model": { "type": ["string", "null"] }, "target": { "type": ["string", "null"] } } }
  }
}
