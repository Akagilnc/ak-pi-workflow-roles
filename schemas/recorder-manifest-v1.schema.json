{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ak.local/schemas/recorder-manifest-v1.schema.json",
  "title": "RecorderManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "archive",
    "invocation",
    "execution",
    "provenance",
    "artifacts",
    "receipt",
    "auditObservation",
    "child",
    "recorder",
    "redaction"
  ],
  "properties": {
    "version": { "const": 1 },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryRoot", "root", "docketId"],
      "properties": {
        "repositoryRoot": { "type": "string", "minLength": 1 },
        "root": { "$ref": "#/$defs/canonicalRelativePath" },
        "docketId": { "$ref": "#/$defs/canonicalRelativePath" }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "cwd", "environment", "stdin", "stdio"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "cwd": { "type": "string", "minLength": 1 },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inherit", "overrides", "unset"],
          "properties": {
            "inherit": { "type": "boolean" },
            "overrides": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            },
            "unset": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "stdin": { "const": "inherit" },
        "stdio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stdout", "stderr"],
          "properties": {
            "stdout": { "const": "tee" },
            "stderr": { "const": "tee" }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "model", "target", "verification"],
      "properties": {
        "package": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "target": { "type": ["string", "null"] },
        "verification": { "const": "unverified" }
      }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "receipt": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["toolName", "toolCallId", "artifactId", "artifactKind"],
          "properties": {
            "toolName": { "type": "string", "minLength": 1 },
            "toolCallId": { "type": "string", "minLength": 1 },
            "artifactId": { "const": "receipt" },
            "artifactKind": {
              "type": "string",
              "enum": [
                "acceptedReceipt",
                "sanitizedDerivativeOfAcceptedReceipt"
              ]
            }
          }
        }
      ]
    },
    "auditObservation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["toolName", "toolCallId", "auditPassed"],
          "properties": {
            "toolName": { "type": "string", "minLength": 1 },
            "toolCallId": { "type": "string", "minLength": 1 },
            "auditPassed": { "const": true },
            "usage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "input": { "type": "number" },
                "output": { "type": "number" },
                "cacheRead": { "type": "number" },
                "cacheWrite": { "type": "number" },
                "totalTokens": { "type": "number" }
              }
            }
          }
        }
      ]
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "exitCode", "signal"],
      "properties": {
        "status": { "type": "string", "enum": ["exited", "signaled"] },
        "exitCode": { "type": ["integer", "null"] },
        "signal": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "exited" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "exitCode": { "type": "integer" },
              "signal": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "signaled" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "exitCode": { "type": "null" },
              "signal": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "recorder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "const": "completed" }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hits"],
      "properties": {
        "hits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ruleId", "location", "count"],
            "properties": {
              "ruleId": { "type": "string", "minLength": 1 },
              "location": { "type": "string", "minLength": 1 },
              "count": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "receipt": { "type": "null" } }
      },
      "then": {
        "properties": {
          "auditObservation": { "type": "null" },
          "artifacts": {
            "type": "array",
            "not": {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": { "enum": ["receipt", "audit-observation"] }
                },
                "required": ["kind"]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "artifacts": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": [
                "id",
                "kind",
                "redactionStatus",
                "stored",
                "receiptArtifactKind"
              ],
              "properties": {
                "id": { "const": "receipt" },
                "kind": { "const": "receipt" },
                "stored": { "$ref": "#/$defs/storedIdentity" },
                "receiptArtifactKind": {
                  "type": "string",
                  "enum": [
                    "acceptedReceipt",
                    "sanitizedDerivativeOfAcceptedReceipt"
                  ]
                }
              }
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": { "auditObservation": { "type": "null" } }
      },
      "then": {
        "properties": {
          "artifacts": {
            "type": "array",
            "not": {
              "contains": {
                "type": "object",
                "properties": { "kind": { "const": "audit-observation" } },
                "required": ["kind"]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "receipt": { "type": "object" },
          "artifacts": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": ["id", "kind", "redactionStatus", "stored"],
              "properties": {
                "id": { "const": "audit-observation" },
                "kind": { "const": "audit-observation" },
                "stored": { "$ref": "#/$defs/storedIdentity" }
              }
            },
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "canonicalRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*|\\.ak)(?:/(?:[A-Za-z0-9][A-Za-z0-9._-]*|\\.ak))*$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "fullSha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "referenceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "repositoryRoot",
        "commit",
        "path",
        "blobOid",
        "sha256",
        "mode"
      ],
      "properties": {
        "identity": { "const": "reference" },
        "repositoryRoot": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/fullSha1" },
        "path": { "$ref": "#/$defs/canonicalRelativePath" },
        "blobOid": { "$ref": "#/$defs/fullSha1" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mode": { "type": "string", "enum": ["100644", "100755"] }
      }
    },
    "storedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "path", "sha256", "byteLength"],
      "properties": {
        "identity": { "const": "stored" },
        "path": { "$ref": "#/$defs/canonicalRelativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 0 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "redactionStatus"],
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "kind": {
          "type": "string",
          "enum": [
            "authority",
            "task",
            "input",
            "exhibit",
            "receipt",
            "audit-observation"
          ]
        },
        "redactionStatus": {
          "type": "string",
          "enum": ["clean", "redacted", "sanitized-derivative"]
        },
        "reference": { "$ref": "#/$defs/referenceIdentity" },
        "stored": { "$ref": "#/$defs/storedIdentity" },
        "receiptArtifactKind": {
          "type": "string",
          "enum": [
            "acceptedReceipt",
            "sanitizedDerivativeOfAcceptedReceipt"
          ]
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": ["reference"],
              "not": { "required": ["stored"] }
            },
            {
              "required": ["stored"],
              "not": { "required": ["reference"] }
            }
          ]
        },
        {
          "if": {
            "properties": { "kind": { "const": "receipt" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["stored", "receiptArtifactKind"],
            "not": { "required": ["reference"] }
          },
          "else": {
            "not": { "required": ["receiptArtifactKind"] }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "audit-observation" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["stored"],
            "not": { "required": ["reference"] }
          }
        }
      ]
    }
  }
}
